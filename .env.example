# ============================================================================
# Mendr Control Plane - environment template
# Copy to .env and fill in. NEVER commit a real .env (it is gitignored).
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
# Postgres superuser (bootstrap/migrations only). Change in every real env.
POSTGRES_SUPERUSER=admin
POSTGRES_PASSWORD=change-me-in-prod
# Least-privilege app role the services connect as (Postgres RLS is enforced for
# non-superusers). Created by infra/init_v2_multitenancy.sql. CHANGE IN PROD.
APP_DB_USERNAME=app_user
APP_DB_PASSWORD=change-me-in-prod

# ── Shared machine credential ────────────────────────────────────────────────
# Guards /api/internal/** (verify/simulate) and authenticates the conversation
# engine to ai-analysis-service (MCP + chat history persistence). REQUIRED for
# MendrScript chat history to save and restore across sessions. Generate with:
#   openssl rand -hex 32
# Must be identical on api-gateway, ai-analysis-service, and conversation-engine.
GATEWAY_INTERNAL_API_KEY=

# ── LLM ──────────────────────────────────────────────────────────────────────
# Provider: anthropic (default) or gemini. Set the API key for the active provider.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Auth / tenancy (incremental rollout) ─────────────────────────────────────
# Applies to every HTTP service (api-gateway, ai-analysis, rule-engine): each
# validates the WorkOS JWT / internal key and binds the tenant the same way.
# Keep false until the frontend WorkOS login is live; then flip to true.
MENDR_AUTH_ENFORCE=false
# WorkOS AuthKit / JWT validation (human dashboard auth).
MENDR_AUTH_WORKOS_JWKS_URI=
MENDR_AUTH_WORKOS_ISSUER=
MENDR_AUTH_WORKOS_AUDIENCE=
MENDR_AUTH_WORKOS_ORG_CLAIM=org_id
# Strict tenancy (no default-tenant fallback) once every caller sends a tenant.
MENDR_TENANCY_FALLBACK_TO_DEFAULT=true

# ── CORS / abuse controls ─────────────────────────────────────────────────────
MENDR_CORS_ALLOWED_ORIGINS=http://localhost:3000
MENDR_CHAT_RATE_LIMIT_PER_MIN=20

# ── Zero-hallucination RCA narrative (conversation-engine) ───────────────────
# Additive telemetry over the deterministic topology CTEs: an LLM SELECTs one of the
# enumerated real dependency paths, every cited edge/node id is symbolically re-verified
# against the live graph, and the whole narrative ABSTAINS unless faithfulness clears the
# risk budget. It never gates a heal. OFF by default. See docs/SERVICE_TOPOLOGY_RCA.md.
MENDR_RCA_NARRATIVE_ENABLED=false
# Forward-dependency depth / path-enumeration caps handed to the topology tools.
MENDR_RCA_MAX_DEPTH=6
MENDR_RCA_MAX_PATHS=20
# Conformal factuality risk budget (alpha): faithfulness must be >= 1 - alpha AND no claim
# may be unsupported, else the narrative abstains.
MENDR_RCA_FACTUALITY_ALPHA=0.05
# Minimum LLM self-confidence on the selected path before rendering (else abstain).
MENDR_RCA_MIN_CONFIDENCE=0.4
