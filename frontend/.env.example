# WorkOS AuthKit (dashboard human auth). Leave REACT_APP_WORKOS_CLIENT_ID unset to
# run without a login wall (safe incremental rollout while the backend has
# MENDR_AUTH_ENFORCE=false). Set it to turn on the WorkOS login flow.
REACT_APP_WORKOS_CLIENT_ID=
# Defaults to window.location.origin when unset.
REACT_APP_WORKOS_REDIRECT_URI=
